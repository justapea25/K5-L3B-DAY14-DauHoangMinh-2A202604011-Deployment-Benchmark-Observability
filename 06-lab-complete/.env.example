# ============================================================
# Biến môi trường của agent (tiêu chí 9). KHÔNG ghi secret thật vào file này.
# Dùng: cp .env.example .env  (file .env đã nằm trong .gitignore)
# ============================================================
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Secret: đặt giá trị thật trong .env (local) hoặc biến môi trường trên Railway/Render
AGENT_API_KEY=change-me

# Local không Docker: redis://localhost:6379/0 — trong docker compose được ghi đè thành redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
